{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and business details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["owner", "manager", "cashier", "demo"] },
        "businessId": { "type": "string", "maxLength": 100 },
        "storeLocationId": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 100 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Authenticated user profiles"
    }
  }
}
